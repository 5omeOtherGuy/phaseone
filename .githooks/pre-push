#!/usr/bin/env bash
# Git pre-push hook; enable it once per checkout with `git config core.hooksPath .githooks`
# (.agents/setup does it in an orb). It refuses a direct push to main, which takes changes only
# through a pull request (AGENTS.md), and runs scripts/pre-push.sh, the local part of the gate;
# the full gate runs in CI. Only the owner skips it, with `git push --no-verify`.
set -euo pipefail
zero=0000000000000000000000000000000000000000
checks=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = refs/heads/main ]; then
    echo "pre-push: main takes changes only through a pull request (AGENTS.md); push a task branch" >&2
    exit 1
  fi
  # A deletion pushes no code.
  [ "$local_sha" = "$zero" ] || checks=1
done
[ "$checks" = 1 ] || exit 0
exec "$(git rev-parse --show-toplevel)/scripts/pre-push.sh"
