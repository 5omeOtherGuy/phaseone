#!/usr/bin/env bash
# CI-only cargo wrapper for the `checks` job of .github/workflows/ci.yml (the split gate).
# That job runs scripts/gate.sh unchanged, every step, except that gate.sh's one workspace test
# run (`cargo test --workspace --locked`) is handed to the two parallel test jobs of the same
# workflow, which together run exactly that test set. Every other cargo call passes through.
# The workflow's final `gate` job is green only when `checks` and both test jobs are green.
set -euo pipefail
self_dir="$(cd "$(dirname "$0")" && pwd)"
real=""
IFS=: read -ra dirs <<<"$PATH"
for d in "${dirs[@]}"; do
  [ "$(cd "$d" 2>/dev/null && pwd)" = "$self_dir" ] && continue
  if [ -x "$d/cargo" ]; then real="$d/cargo"; break; fi
done
[ -n "$real" ] || { echo "ci cargo wrapper: no real cargo on PATH" >&2; exit 127; }
if [ "$*" = "test --workspace --locked" ]; then
  echo "ci: cargo test --workspace --locked runs in the parallel jobs test-modules and test-workspace"
  exit 0
fi
exec "$real" "$@"
