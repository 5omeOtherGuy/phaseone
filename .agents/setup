#!/usr/bin/env bash
# Amp orb setup: installs the toolchain CI uses and fetches Cargo dependencies.
# Build only the packages a task needs afterward; the full gate belongs on GitHub's runners.
# Runs once per fresh orb and again on a stale snapshot, so every step is idempotent and cheap
# when its result is already present. Orb-only; workstations keep their own setup (AGENTS.md).
set -euo pipefail
[[ -n ${AMP_ORB:-} ]] || { echo "setup: orb-only (AMP_ORB unset); see AGENTS.md for workstation setup" >&2; exit 0; }
cd "$(dirname "$0")/.."
repo_root="$PWD"

step() { printf '\n== %s (%ss)\n' "$*" "$SECONDS"; }

# The Rust version is the one CI pins as dtolnay/rust-toolchain's `toolchain` input in the
# gate-setup action (#857 moved it out of ci.yml); wasm-tools is pinned in
# modules/toolchain.pins. Read both so a pin bump needs no edit here.
rust_version="$(sed -n 's/^ *toolchain: *\([0-9][0-9.]*\) *$/\1/p' .github/actions/gate-setup/action.yml | sort -u)"
[[ $rust_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "setup: expected one Rust pin in .github/actions/gate-setup/action.yml, got: $rust_version" >&2; exit 1; }
wasm_tools_version="$(sed -n 's/^WASM_TOOLS=//p' modules/toolchain.pins)"
[[ -n $wasm_tools_version ]] || { echo "setup: no WASM_TOOLS pin in modules/toolchain.pins" >&2; exit 1; }

step "system packages"
# bubblewrap: the sandbox boundary suites and scripts/gate.sh's bwrap probe need it (ADR-0097).
if ! dpkg-query -W -f='${Status}' bubblewrap 2>/dev/null | grep -q 'ok installed'; then
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq bubblewrap
fi

step "rustup and Rust $rust_version"
cargo_home="$HOME/.cargo"
if [[ ! -x $cargo_home/bin/rustup ]]; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
    sh -s -- -y --profile minimal --default-toolchain none --no-modify-path
fi
export PATH="$cargo_home/bin:$PATH"
# rustup skips components and targets that are already installed.
rustup toolchain install "$rust_version" --profile minimal \
  --component rustfmt --component clippy --target wasm32-unknown-unknown
rustup default "$rust_version"

step "wasm-tools $wasm_tools_version"
if [[ "$("$cargo_home/bin/wasm-tools" --version 2>/dev/null)" != "wasm-tools $wasm_tools_version"* ]]; then
  tmp="$(mktemp -d)"
  name="wasm-tools-$wasm_tools_version-$(uname -m)-linux"
  curl --proto '=https' --tlsv1.2 -sSfL -o "$tmp/$name.tar.gz" \
    "https://github.com/bytecodealliance/wasm-tools/releases/download/v$wasm_tools_version/$name.tar.gz"
  tar -xzf "$tmp/$name.tar.gz" -C "$tmp"
  install -m 0755 "$tmp/$name/wasm-tools" "$cargo_home/bin/wasm-tools"
  rm -rf -- "$tmp"
fi

step "login shell environment"
# ~/.bash_profile shadows ~/.profile, so rustup's own PATH edit would not reach Amp or services.
# XDG_RUNTIME_DIR: the sandbox suites skip without one and CI counts that skip as a failure;
# .agents/resume creates the directory, which /run does not keep across a restart.
marker="# phaseone orb: Rust toolchain and runtime dir"
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'PROFILE'

# phaseone orb: Rust toolchain and runtime dir
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
[ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ] && export XDG_RUNTIME_DIR="/run/user/$(id -u)"
PROFILE
fi

step "local Cargo config"
# The untracked per-checkout config the gate would write on its first run (target below
# ~/.cache/cargo-target, rustc-serial slots); written now so the snapshot holds its target dir.
scripts/local-cargo-config.sh

step "cargo fetch"
cargo fetch --locked
cargo fetch --locked --manifest-path modules/Cargo.toml

step "toolchain check"
# The check prints its failures on stdout; show them only when it fails.
toolchain_record="$(scripts/module-toolchain.sh --check)" || { printf '%s\n' "$toolchain_record" >&2; exit 1; }
bwrap --ro-bind / / --dev /dev --proc /proc true || echo "setup: warning: bwrap is unusable in this orb; sandbox suites will skip" >&2

# Do not compile during setup. The former module + workspace-test prebuild allowed
# 300 + 900 seconds, consuming Amp's entire 20-minute setup limit before installation
# and fetching were counted. A timeout prevents a refreshed snapshot, repeating the
# cold build on later orbs. Keep existing build outputs on stale snapshots untouched.

notes_marker="<!-- phaseone orb notes -->"
notes="$HOME/.config/amp/AGENTS.md"
mkdir -p "${notes%/*}"
if ! grep -Fqx "$notes_marker" "$notes" 2>/dev/null; then
  cat >> "$notes" <<NOTES

$notes_marker
## phaseone in an Amp orb

- The orb is not the owner's workstation: there are no \`~/projects\` lanes or SSD/HDD tiers. The main checkout is \`$repo_root\`; use \`scripts/new-worktree.sh\` for edits as AGENTS.md requires.
- \`.agents/setup\` installed the Rust toolchain CI pins (rustfmt, clippy, wasm32-unknown-unknown), the pinned wasm-tools and bubblewrap, wrote \`.cargo/config.toml\` and fetched every crate.
- Setup does not prebuild modules or workspace tests. Build modules with \`scripts/build-modules.sh --all\` when needed and run focused package tests; restored build outputs are left intact.
- Orbs are small (check \`nproc\` and \`free -g\`); keep builds to one package where you can and let CI run the full gate.
NOTES
fi

step "git hooks and credentials"
# .githooks/pre-push refuses a push to main and runs scripts/pre-push.sh (AGENTS.md).
git config core.hooksPath .githooks
# Which credentials this orb has, never their values: live tests need them, the gate never does.
if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
  echo "setup: gh is authenticated"
else
  echo "setup: gh is not authenticated"
fi
for name in ANTHROPIC_API_KEY OPENAI_API_KEY ZAI_API_KEY KIMI_API_KEY OPENCODE_API_KEY \
  OPENCODE_ZEN_API_KEY CLINE_PASS_API_KEY; do
  if [[ -n ${!name:-} ]]; then echo "setup: $name is set"; fi
done

step "done"
